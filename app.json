{
  "expo": {
    "name": "Orbit",
    "slug": "orbit-dating-app",
    "scheme": "orbit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f2ece3",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.orbit.tracker",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.orbit.tracker",
      "versionCode": 11,
      "adaptiveIcon": {
        "backgroundColor": "#241f1b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#241f1b",
          "imageWidth": 150
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Orbit uses Face ID so only you can open your journal."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Orbit reads your calendar only to pre-fill who and where a date was. Nothing leaves your device."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#d85a4a"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0c0ce03e-6f44-430d-bcd7-55d2c3ef4754"
      }
    },
    "owner": "karmak40",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0c0ce03e-6f44-430d-bcd7-55d2c3ef4754"
    }
  }
}
